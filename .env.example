# ============================================================
# ORDAL — environment variables
# Copy to .env for local dev; set the same keys in Vercel
# for production. NEVER commit real credentials.
# ============================================================

# --- Database (PostgreSQL) ---------------------------------
# LOCAL DEV (embedded-postgres via `bun run db:serve`):
POSTGRES_PRISMA_URL=postgresql://ordal:ordal@localhost:5433/ordal
POSTGRES_URL_NON_POOLING=postgresql://ordal:ordal@localhost:5433/ordal

# PRODUCTION (Supabase → Project Settings → Database → Connection string):
# POSTGRES_PRISMA_URL = Transaction pooler (port 6543) + Prisma serverless params:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# POSTGRES_URL_NON_POOLING = Session/direct connection (port 5432) — used ONLY by
#   `prisma migrate deploy` / `prisma db push`:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Site / SEO --------------------------------------------
# Canonical URL used by metadata, sitemap, OG image (default: https://ordal.app)
NEXT_PUBLIC_SITE_URL=https://ordal.app
NEXT_PUBLIC_ORDAL_WINDOWS_URL=
NEXT_PUBLIC_ORDAL_MACOS_URL=

# HMAC key for hashing abuse signals. Use a random 32+ byte value in production.
ABUSE_HASH_SECRET=
# Separate 32+ byte secrets for desktop device hashes and email codes.
DEVICE_HASH_PEPPER=
EMAIL_CODE_SECRET=
# Optional comma-separated additions to the built-in disposable email blocklist.
BLOCKED_EMAIL_DOMAINS=

# Public production origin, without trailing slash.
APP_URL=https://ordal-web.vercel.app

# Google OAuth Web application credentials. Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email. Verify EMAIL_FROM domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=ORDAL <noreply@applywithordal.com>

# Payment gateways. Start in sandbox, then replace with production credentials.
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRODUCTION=false

# Minimum 32 random bytes. Used only by the owner admin endpoint.
ADMIN_API_TOKEN=
# Optional comma-separated emails with permanent free access.
COMPLIMENTARY_EMAILS=

# --- Chatbot (ORDAL Assist) --------------------------------
# Groq API key → https://console.groq.com/keys (free tier available)
# REQUIRED IN PRODUCTION: without a key, /api/chat returns 503 and the
# chat widget shows its "unavailable" reply — production must never
# fall back to another provider. In local development (NODE_ENV=
# "development") an empty key falls back to the sandbox SDK so the
# widget keeps working while developing.
GROQ_API_KEY=
# Optional model override — must be a model your Groq tier can access
# (see https://console.groq.com/docs/models). Default: openai/gpt-oss-120b
# (llama-3.3-70b-versatile was shut down for Free/Developer tiers on
# 2026-08-16). Solid non-reasoning alternative:
#   GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=

# ============================================================
# Deployment runbook (Supabase + Vercel, ordered migration &
# deploy commands): docs/DEPLOYMENT.md
# ============================================================
