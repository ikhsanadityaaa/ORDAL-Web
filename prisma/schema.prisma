generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailCanonical      String?   @unique
  name                String
  password            String?
  authProvider        String    @default("email") // "email" | "google"
  uniqueUserCode      String    @unique // ORD-USER-XXXXXX
  activationCode      String?   @unique // ORD-XXXX-XXXX-XXXX, issued when user pays INSIDE the app
  emailVerifiedAt     DateTime?
  complimentaryAccess Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trial             Trial?
  downloads         Download[]
  sessions          Session[]
  abuseEvents       AbuseEvent[]
  secureDevices     SecureDevice[]
  appSessions       AppSession[]
  trialDeviceClaims TrialDeviceClaim[]
  licenseGrant      LicenseGrant?
  payments          Payment[]
  oauthAttempts     AppOAuthAttempt[]
  verificationCodes AppVerificationCode[]
}

model AbuseEvent {
  id          BigInt   @id @default(autoincrement())
  eventType   String   @map("event_type")
  subjectHash String   @map("subject_hash")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  detail      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType, subjectHash, createdAt])
  @@index([createdAt])
  @@map("app_abuse_events")
}

model Trial {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  expiresAt DateTime
  status    String   @default("active") // "active" | "expired"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Download {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appVersion   String   @default("1.0.0")
  platform     String // "windows" | "macos"
  downloadedAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SecureDevice {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKey    String
  name         String       @default("")
  os           String       @default("")
  appVersion   String       @default("")
  lastLoginAt  DateTime     @default(now())
  lastActiveAt DateTime     @default(now())
  createdAt    DateTime     @default(now())
  sessions     AppSession[]

  @@unique([userId, deviceKey])
  @@index([userId, lastLoginAt])
  @@map("secure_devices")
}

model AppSession {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  device     SecureDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  expiresAt  DateTime
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("app_sessions_secure")
}

model TrialDeviceClaim {
  deviceKey String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimedAt DateTime @default(now())

  @@index([userId])
  @@map("trial_device_claims")
}

model LicenseGrant {
  id          String    @id
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  method      String    @default("payment")
  paymentId   String?   @unique @map("payment_id")
  payment     Payment?  @relation(fields: [paymentId], references: [id])
  activatedAt DateTime  @default(now()) @map("activated_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([paymentId])
  @@map("app_licenses")
}

model Payment {
  id            String        @id
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        String
  amount        Int
  baseAmount    Int           @map("base_amount")
  uniqueSuffix  Int           @default(0) @map("unique_suffix")
  amountUsd     Decimal?      @map("amount_usd") @db.Decimal(10, 2)
  currency      String        @default("IDR")
  status        String        @default("pending")
  reference     String        @default("")
  gateway       String        @default("manual")
  gatewayRef    String?       @map("gateway_ref")
  qrString      String?       @map("qr_string")
  qrUrl         String?       @map("qr_url")
  approveUrl    String?       @map("approve_url")
  note          String?
  verifiedAt    DateTime?     @map("verified_at")
  invoiceSentAt DateTime?     @map("invoice_sent_at")
  expiresAt     DateTime      @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  license       LicenseGrant?

  @@index([userId, createdAt])
  @@index([gateway, gatewayRef])
  @@map("app_payments")
}

model AppOAuthAttempt {
  state        String    @id
  codeVerifier String    @map("code_verifier")
  deviceKey    String    @map("device_key")
  deviceName   String    @default("") @map("device_name")
  os           String    @default("")
  appVersion   String    @default("") @map("app_version")
  status       String    @default("pending")
  userId       String?   @map("user_id")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  error        String?
  expiresAt    DateTime  @map("expires_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("app_oauth_attempts")
}

model AppVerificationCode {
  id        BigInt   @id @default(autoincrement())
  email     String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("app_verification_codes_secure")
}
