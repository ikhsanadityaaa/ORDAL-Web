generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  emailCanonical String?  @unique
  name           String
  password       String?
  authProvider   String   @default("email") // "email" | "google"
  uniqueUserCode String   @unique // ORD-USER-XXXXXX
  activationCode String?  @unique // ORD-XXXX-XXXX-XXXX, issued when user pays INSIDE the app
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trial          Trial?
  downloads      Download[]
  sessions       Session[]
  abuseEvents    AbuseEvent[]
  trialGrant     TrialGrant?
}

model AbuseEvent {
  id          BigInt   @id @default(autoincrement())
  eventType   String   @map("event_type")
  subjectHash String   @map("subject_hash")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  detail      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType, subjectHash, createdAt])
  @@map("app_abuse_events")
}

model TrialGrant {
  userId             String   @id @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalEmailHash String   @unique @map("canonical_email_hash")
  deviceHash         String   @unique @map("device_hash")
  grantedAt          DateTime @default(now()) @map("granted_at")

  @@map("app_trial_grants")
}

model Trial {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  status     String   @default("active") // "active" | "expired"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Download {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appVersion  String   @default("1.0.0")
  platform    String // "windows" | "macos"
  downloadedAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
